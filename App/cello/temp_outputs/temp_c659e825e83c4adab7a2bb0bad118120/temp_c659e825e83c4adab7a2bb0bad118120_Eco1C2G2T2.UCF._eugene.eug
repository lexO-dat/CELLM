cds BetI(.SEQUENCE(""));
terminator L3S3P11(.SEQUENCE("CCAATTATTGAACACCCTTCGGGGTGTTTTTTTGTTTCTGGTCTCCC"));
promoter pBetI(.SEQUENCE("AGCGCGGGTGAGAGGgattcgttaccaatagacaATTgATTGGACGTTCAATATAAtgctagc"));
ribozyme RiboJ64(.SEQUENCE("AGGAGTCAATTAATGTGCTTTTAATTCTGATGAGACGGTGACGTCGAAACTCCCTCTACAAATAATTTTGTTTAA"));
rbs N1(.SEQUENCE("TACGCTATGGACTATGTTTTCTGCTATGGACTATGTTTTCACACACGAGATGCCTCG"));
cds LmrA(.SEQUENCE(""));
