rbs H1(.SEQUENCE("ACCCCCGAG"));
cds HlyIIR(.SEQUENCE(""));
terminator ECK120010799(.SEQUENCE("gttatgagtcAGGAAAAAAGGCGACAGAGTAATCTGTCGCCTTTTTTCTTtgcttgcttt"));
