promoter pVanR(.SEQUENCE("TGTATAAAGTCCGCCattggatccaattgacagctagctcagtcctaggtaccattggatccaat"));
scar F_scar(.SEQUENCE("CGCT"));
scar E_scar(.SEQUENCE("GCTT"));
scar D_scar(.SEQUENCE("AGGT"));
scar C_scar(.SEQUENCE("AATG"));
scar B_scar(.SEQUENCE("TACG"));
scar A_scar(.SEQUENCE("GGAG"));
scar Y_scar(.SEQUENCE("ATTG"));
scar X_scar(.SEQUENCE("TGTC"));
scar V_scar(.SEQUENCE("TCTG"));
scar U_scar(.SEQUENCE("GGGC"));
scar R_scar(.SEQUENCE("GTAA"));
scar Q_scar(.SEQUENCE("GAGT"));
scar P_scar(.SEQUENCE("CCTA"));
scar O_scar(.SEQUENCE("ATGC"));
scar G_scar(.SEQUENCE("ATAG"));
cassette YFP_cassette(.SEQUENCE(""));

PartType fencepost;
fencepost L1();
fencepost L2();
fencepost L3();

cassette N1_LmrA_cassette();
Device N1_LmrA(
    pLux2,
    N1_LmrA_cassette
);

cassette H1_HlyIIR_cassette();
Device H1_HlyIIR(
    pCin,
    H1_HlyIIR_cassette
);

cassette B2_BM3R1_cassette();
Device B2_BM3R1(
    pTet,
    B2_BM3R1_cassette
);

cassette S4_SrpR_cassette();
Device S4_SrpR(
    pLmrA,
    pHlyIIR,
    S4_SrpR_cassette
);

cassette P2_PhlF_cassette();
Device P2_PhlF(
    pSrpR,
    P2_PhlF_cassette
);

cassette A1_AmtR_cassette();
Device A1_AmtR(
    pTet,
    pSrpR,
    A1_AmtR_cassette
);

cassette V1_VanR_cassette();
Device V1_VanR(
    pBM3R1,
    pPhlF,
    V1_VanR_cassette
);

cassette E1_BetI_cassette();
Device E1_BetI(
    pAmtR,
    pVanR,
    E1_BetI_cassette
);

Device YFP_reporter(
    pSrpR,
    YFP_cassette
);

Device YFP_reporter_2(
    pBetI,
    YFP_cassette
);


Rule N1_LmrARule0( ON N1_LmrA:
    ALL_FORWARD
);

Rule H1_HlyIIRRule0( ON H1_HlyIIR:
    ALL_FORWARD
);

Rule B2_BM3R1Rule0( ON B2_BM3R1:
    ALL_FORWARD
);

Rule S4_SrpRRule0( ON S4_SrpR:
    ALL_FORWARD
);

Rule P2_PhlFRule0( ON P2_PhlF:
    ALL_FORWARD
);

Rule A1_AmtRRule0( ON A1_AmtR:
    ALL_FORWARD
);

Rule V1_VanRRule0( ON V1_VanR:
    ALL_FORWARD
);

Rule E1_BetIRule0( ON E1_BetI:
    ALL_FORWARD
);

Rule YFP_reporterRule0( ON YFP_reporter:
    ALL_FORWARD
);

Rule YFP_reporter_2Rule0( ON YFP_reporter_2:
    ALL_FORWARD
);


N1_LmrA_devices = product(N1_LmrA);
H1_HlyIIR_devices = product(H1_HlyIIR);
B2_BM3R1_devices = product(B2_BM3R1);
S4_SrpR_devices = product(S4_SrpR);
P2_PhlF_devices = product(P2_PhlF);
A1_AmtR_devices = product(A1_AmtR);
V1_VanR_devices = product(V1_VanR);
E1_BetI_devices = product(E1_BetI);
YFP_reporter_devices = product(YFP_reporter);
YFP_reporter_2_devices = product(YFP_reporter_2);

Device N1_LmrADevice();
Device H1_HlyIIRDevice();
Device B2_BM3R1Device();
Device S4_SrpRDevice();
Device P2_PhlFDevice();
Device A1_AmtRDevice();
Device V1_VanRDevice();
Device E1_BetIDevice();
Device YFP_reporterDevice();
Device YFP_reporter_2Device();

Device circuit();

Rule CircuitRule0( ON circuit:
    CONTAINS N1_LmrA AND
    CONTAINS H1_HlyIIR AND
    CONTAINS B2_BM3R1 AND
    CONTAINS S4_SrpR AND
    CONTAINS P2_PhlF AND
    CONTAINS A1_AmtR AND
    CONTAINS V1_VanR AND
    CONTAINS E1_BetI AND
    CONTAINS YFP_reporter AND
    CONTAINS YFP_reporter_2 AND
    YFP_reporter NEXTTO L3 AND
    ENDSWITH YFP_reporter AND
    STARTSWITH L1 AND
    L2 NEXTTO L1 AND
    CONTAINS L1 AND
    CONTAINS L2 AND
    CONTAINS L3 AND
    V1_VanR BEFORE P2_PhlF AND
    V1_VanR BEFORE S4_SrpR AND
    V1_VanR BEFORE A1_AmtR AND
    V1_VanR BEFORE B2_BM3R1 AND
    V1_VanR BEFORE N1_LmrA AND
    V1_VanR BEFORE H1_HlyIIR AND
    V1_VanR BEFORE E1_BetI AND
    P2_PhlF BEFORE S4_SrpR AND
    P2_PhlF BEFORE A1_AmtR AND
    P2_PhlF BEFORE B2_BM3R1 AND
    P2_PhlF BEFORE N1_LmrA AND
    P2_PhlF BEFORE H1_HlyIIR AND
    P2_PhlF BEFORE E1_BetI AND
    S4_SrpR BEFORE A1_AmtR AND
    S4_SrpR BEFORE B2_BM3R1 AND
    S4_SrpR BEFORE N1_LmrA AND
    S4_SrpR BEFORE H1_HlyIIR AND
    S4_SrpR BEFORE E1_BetI AND
    A1_AmtR BEFORE B2_BM3R1 AND
    A1_AmtR BEFORE N1_LmrA AND
    A1_AmtR BEFORE H1_HlyIIR AND
    A1_AmtR BEFORE E1_BetI AND
    B2_BM3R1 BEFORE N1_LmrA AND
    B2_BM3R1 BEFORE H1_HlyIIR AND
    B2_BM3R1 BEFORE E1_BetI AND
    N1_LmrA BEFORE H1_HlyIIR AND
    N1_LmrA BEFORE E1_BetI AND
    H1_HlyIIR BEFORE E1_BetI AND
    CONTAINS N1_LmrA AND
    CONTAINS H1_HlyIIR AND
    CONTAINS B2_BM3R1 AND
    CONTAINS S4_SrpR AND
    CONTAINS P2_PhlF AND
    CONTAINS A1_AmtR AND
    CONTAINS V1_VanR AND
    CONTAINS E1_BetI AND
    CONTAINS YFP_reporter AND
    CONTAINS YFP_reporter_2
);
Array allResults;

for(num i1 = 0; i1 < sizeof(N1_LmrA_devices); i1 = i1 + 1) {} 
for(num i2 = 0; i2 < sizeof(H1_HlyIIR_devices); i2 = i2 + 1) {} 
for(num i3 = 0; i3 < sizeof(B2_BM3R1_devices); i3 = i3 + 1) {} 
for(num i4 = 0; i4 < sizeof(S4_SrpR_devices); i4 = i4 + 1) {} 
for(num i5 = 0; i5 < sizeof(P2_PhlF_devices); i5 = i5 + 1) {} 
for(num i6 = 0; i6 < sizeof(A1_AmtR_devices); i6 = i6 + 1) {} 
for(num i7 = 0; i7 < sizeof(V1_VanR_devices); i7 = i7 + 1) {} 
for(num i8 = 0; i8 < sizeof(E1_BetI_devices); i8 = i8 + 1) {} 
for(num i9 = 0; i9 < sizeof(YFP_reporter_devices); i9 = i9 + 1) {} 
for(num i10 = 0; i10 < sizeof(YFP_reporter_2_devices); i10 = i10 + 1) {} 

N1_LmrADevice = N1_LmrA_devices[i1];
H1_HlyIIRDevice = H1_HlyIIR_devices[i2];
B2_BM3R1Device = B2_BM3R1_devices[i3];
S4_SrpRDevice = S4_SrpR_devices[i4];
P2_PhlFDevice = P2_PhlF_devices[i5];
A1_AmtRDevice = A1_AmtR_devices[i6];
V1_VanRDevice = V1_VanR_devices[i7];
E1_BetIDevice = E1_BetI_devices[i8];
YFP_reporterDevice = YFP_reporter_devices[i9];
YFP_reporter_2Device = YFP_reporter_2_devices[i10];

Device circuit(
    N1_LmrADevice,
    H1_HlyIIRDevice,
    B2_BM3R1Device,
    S4_SrpRDevice,
    P2_PhlFDevice,
    A1_AmtRDevice,
    V1_VanRDevice,
    E1_BetIDevice,
    YFP_reporterDevice,
    YFP_reporter_2Device,
    L1,
    L2,
    L3
);


result = permute(circuit);

allResults = allResults + result;

}
}
}
}
}
