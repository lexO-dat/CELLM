promoter pHlyIIR(.SEQUENCE("ACCAGGAATCTGAACGATTCGTTACCAATTGACATATTTAAAATTCTTGTTTAAAatgctagc"));
ribozyme ElvJ(.SEQUENCE("CTGAagCCCCATAGGGTGGTGTGTACCACCCCTGATGAGTCCAAAAGGACGAAATGGGGcctctacaaataattttgtttaa"));
rbs I1(.SEQUENCE("ATTGCTATGGACTATGTTTCAAAGTGAGAATACTAG"));
cds IcaRA(.SEQUENCE(""));
terminator ECK120016170(.SEQUENCE("ACAATTTTCGAAAAAACCCGCTTCGGCGGGTTTTTTTATAGCTAAAA"));
promoter pIcaRA(.SEQUENCE("GTCAACTCATAAGATtctgattcgttaccaattgacaaTTCACCTACCTTTCGTTAGgTTAGGTTGT"));
ribozyme PlmJ(.SEQUENCE("CTGAAGTCATAAGTCTGGGCTAAGCCCACTGATGAGTCGCTGAAATGCGACGAAACTTATGACCTCTACAAATAATTTTGTTTAA"));
rbs L1(.SEQUENCE("GTCCTATGGACTTTTTCATACAGGAGAACCCTCG"));
cds LitR(.SEQUENCE(""));
terminator L3S2P24(.SEQUENCE("CTCGGTACCAAATTCCAGAAAAGACACCCGAAAGGGTGTTTTTTCGTTTTGGTCC"));
promoter pLitR(.SEQUENCE("CGAGCGTAGAGCTTAgattcgttaccaatTGACAAATTTATAAATTGTCAgtacagtcctagc"));
ribozyme RiboJ60(.SEQUENCE("CTGAAGTCGTCAAGTGCTGTGCTTGCACTTCTGATGAGGCAGTGATGCCGAAACGACCTCTACAAATAATTTTGTTTAA"));
cds QacR(.SEQUENCE(""));
terminator ECK120010818(.SEQUENCE("GTCAGTTTCACCTGTTTTACGTAAAAACCCGCTTCGGCGGGTTTTTACTTTTGG"));
promoter pQacR(.SEQUENCE("GGTATGGAAGCTATACGTTACCAATTGACAGCTAGCTCAGTCCTACTTTAGTATATAGACCGTGCGATCGGTCTATA"));
rbs Q2(.SEQUENCE("GCCATGCCATTGGCTTTTGATAGAGGACAACTACTAG"));
ribozyme RiboJ10(.SEQUENCE("CTGAAGCGCTCAACGGGTGTGCTTCCCGTTCTGATGAGTCCGTGAGGACGAAAGCGCCTCTACAAATAATTTTGTTTAA"));
cds SrpR(.SEQUENCE(""));
promoter pSrpR(.SEQUENCE("TCTATGATTGGTCCAGATTCGTTACCAATTGACAGCTAGCTCAGTCCTAGGTATATACATACATGCTTGTTTGTTTGTAAAC"));
terminator ECK120029600(.SEQUENCE("TTCAGCCAAAAAACTTAAGACCGCCGGTCTTGTCCACTACCTTGCAGTAATGCGGTGGACAGGATCGGCGGTTTTCTTTTCTCTTCTCAA"));
rbs S4(.SEQUENCE("CTATGGACTATGTTTTCACACAGGAAATACCAGG"));
scar F_scar(.SEQUENCE("CGCT"));
scar E_scar(.SEQUENCE("GCTT"));
scar D_scar(.SEQUENCE("AGGT"));
scar C_scar(.SEQUENCE("AATG"));
scar B_scar(.SEQUENCE("TACG"));
scar A_scar(.SEQUENCE("GGAG"));
scar Y_scar(.SEQUENCE("ATTG"));
scar X_scar(.SEQUENCE("TGTC"));
scar V_scar(.SEQUENCE("TCTG"));
scar U_scar(.SEQUENCE("GGGC"));
scar R_scar(.SEQUENCE("GTAA"));
scar Q_scar(.SEQUENCE("GAGT"));
scar P_scar(.SEQUENCE("CCTA"));
scar O_scar(.SEQUENCE("ATGC"));
scar G_scar(.SEQUENCE("ATAG"));
cassette YFP_cassette(.SEQUENCE(""));

PartType fencepost;
fencepost Loc1();
fencepost Loc2();
fencepost Loc3();

cassette A1_AmtR_cassette();
Device A1_AmtR(
    pTac,
    A1_AmtR_cassette
);

cassette H1_HlyIIR_cassette();
Device H1_HlyIIR(
    pBAD,
    H1_HlyIIR_cassette
);

cassette Q2_QacR_cassette();
Device Q2_QacR(
    pTet,
    Q2_QacR_cassette
);

cassette E1_BetI_cassette();
Device E1_BetI(
    pAmtR,
    pHlyIIR,
    E1_BetI_cassette
);

cassette I1_IcaRA_cassette();
Device I1_IcaRA(
    pBetI,
    I1_IcaRA_cassette
);

cassette S4_SrpR_cassette();
Device S4_SrpR(
    pTet,
    pBetI,
    S4_SrpR_cassette
);

cassette L1_LitR_cassette();
Device L1_LitR(
    pQacR,
    pIcaRA,
    L1_LitR_cassette
);

cassette B3_BM3R1_cassette();
Device B3_BM3R1(
    pSrpR,
    pLitR,
    B3_BM3R1_cassette
);

Device YFP_reporter(
    pBetI,
    YFP_cassette
);

Device YFP_reporter_2(
    pBM3R1,
    YFP_cassette
);


Rule A1_AmtRRule0( ON A1_AmtR:
    STARTSWITH pTac AND
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule H1_HlyIIRRule0( ON H1_HlyIIR:
    STARTSWITH pBAD AND
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule Q2_QacRRule0( ON Q2_QacR:
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule E1_BetIRule0( ON E1_BetI:
    ALL_FORWARD AND
    ALL_FORWARD AND
    pAmtR BEFORE pHlyIIR
);

Rule I1_IcaRARule0( ON I1_IcaRA:
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule S4_SrpRRule0( ON S4_SrpR:
    pTet BEFORE pBetI AND
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule L1_LitRRule0( ON L1_LitR:
    ALL_FORWARD AND
    ALL_FORWARD AND
    STARTSWITH pQacR AND
    pQacR BEFORE pIcaRA
);

Rule B3_BM3R1Rule0( ON B3_BM3R1:
    ALL_FORWARD AND
    ALL_FORWARD AND
    STARTSWITH pSrpR AND
    pSrpR BEFORE pLitR
);

Rule YFP_reporterRule0( ON YFP_reporter:
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule YFP_reporter_2Rule0( ON YFP_reporter_2:
    ALL_FORWARD AND
    ALL_FORWARD AND
    STARTSWITH pBM3R1
);


A1_AmtR_devices = product(A1_AmtR);
H1_HlyIIR_devices = product(H1_HlyIIR);
Q2_QacR_devices = product(Q2_QacR);
E1_BetI_devices = product(E1_BetI);
I1_IcaRA_devices = product(I1_IcaRA);
S4_SrpR_devices = product(S4_SrpR);
L1_LitR_devices = product(L1_LitR);
B3_BM3R1_devices = product(B3_BM3R1);
YFP_reporter_devices = product(YFP_reporter);
YFP_reporter_2_devices = product(YFP_reporter_2);

Device A1_AmtRDevice();
Device H1_HlyIIRDevice();
Device Q2_QacRDevice();
Device E1_BetIDevice();
Device I1_IcaRADevice();
Device S4_SrpRDevice();
Device L1_LitRDevice();
Device B3_BM3R1Device();
Device YFP_reporterDevice();
Device YFP_reporter_2Device();

Device circuit();

Rule CircuitRule0( ON circuit:
    CONTAINS A1_AmtR AND
    CONTAINS H1_HlyIIR AND
    CONTAINS Q2_QacR AND
    CONTAINS E1_BetI AND
    CONTAINS I1_IcaRA AND
    CONTAINS S4_SrpR AND
    CONTAINS L1_LitR AND
    CONTAINS B3_BM3R1 AND
    CONTAINS YFP_reporter AND
    CONTAINS YFP_reporter_2 AND
    YFP_reporter NEXTTO Loc3 AND
    YFP_reporter AFTER Loc3 AND
    STARTSWITH Loc1 AND
    Loc2 NEXTTO Loc1 AND
    S4_SrpR BEFORE B3_BM3R1 AND
    S4_SrpR BEFORE E1_BetI AND
    S4_SrpR BEFORE L1_LitR AND
    S4_SrpR BEFORE I1_IcaRA AND
    S4_SrpR BEFORE Q2_QacR AND
    S4_SrpR BEFORE H1_HlyIIR AND
    S4_SrpR BEFORE A1_AmtR AND
    B3_BM3R1 BEFORE E1_BetI AND
    B3_BM3R1 BEFORE I1_IcaRA AND
    B3_BM3R1 BEFORE L1_LitR AND
    B3_BM3R1 BEFORE Q2_QacR AND
    B3_BM3R1 BEFORE H1_HlyIIR AND
    B3_BM3R1 BEFORE A1_AmtR AND
    E1_BetI BEFORE L1_LitR AND
    E1_BetI BEFORE I1_IcaRA AND
    E1_BetI BEFORE Q2_QacR AND
    E1_BetI BEFORE H1_HlyIIR AND
    E1_BetI BEFORE A1_AmtR AND
    L1_LitR BEFORE I1_IcaRA AND
    L1_LitR BEFORE Q2_QacR AND
    L1_LitR BEFORE H1_HlyIIR AND
    L1_LitR BEFORE A1_AmtR AND
    I1_IcaRA BEFORE Q2_QacR AND
    I1_IcaRA BEFORE H1_HlyIIR AND
    I1_IcaRA BEFORE A1_AmtR AND
    Q2_QacR BEFORE H1_HlyIIR AND
    Q2_QacR BEFORE A1_AmtR AND
    H1_HlyIIR BEFORE A1_AmtR AND
    S4_SrpR AFTER Loc2 AND
    B3_BM3R1 AFTER Loc2 AND
    E1_BetI AFTER Loc2 AND
    L1_LitR AFTER Loc2 AND
    I1_IcaRA AFTER Loc2 AND
    Q2_QacR AFTER Loc2 AND
    H1_HlyIIR AFTER Loc2 AND
    A1_AmtR AFTER Loc2 AND
    S4_SrpR BEFORE Loc3 AND
    B3_BM3R1 BEFORE Loc3 AND
    E1_BetI BEFORE Loc3 AND
    L1_LitR BEFORE Loc3 AND
    I1_IcaRA BEFORE Loc3 AND
    Q2_QacR BEFORE Loc3 AND
    H1_HlyIIR BEFORE Loc3 AND
    A1_AmtR BEFORE Loc3 AND
    ALL_FORWARD AND
    CONTAINS A1_AmtR AND
    CONTAINS H1_HlyIIR AND
    CONTAINS Q2_QacR AND
    CONTAINS E1_BetI AND
    CONTAINS I1_IcaRA AND
    CONTAINS S4_SrpR AND
    CONTAINS L1_LitR AND
    CONTAINS B3_BM3R1 AND
    CONTAINS YFP_reporter AND
    CONTAINS YFP_reporter_2
);
Array allResults;

for(num i1 = 0; i1 < sizeof(A1_AmtR_devices); i1 = i1 + 1) {} 
for(num i2 = 0; i2 < sizeof(H1_HlyIIR_devices); i2 = i2 + 1) {} 
for(num i3 = 0; i3 < sizeof(Q2_QacR_devices); i3 = i3 + 1) {} 
for(num i4 = 0; i4 < sizeof(E1_BetI_devices); i4 = i4 + 1) {} 
for(num i5 = 0; i5 < sizeof(I1_IcaRA_devices); i5 = i5 + 1) {} 
for(num i6 = 0; i6 < sizeof(S4_SrpR_devices); i6 = i6 + 1) {} 
for(num i7 = 0; i7 < sizeof(L1_LitR_devices); i7 = i7 + 1) {} 
for(num i8 = 0; i8 < sizeof(B3_BM3R1_devices); i8 = i8 + 1) {} 
for(num i9 = 0; i9 < sizeof(YFP_reporter_devices); i9 = i9 + 1) {} 
for(num i10 = 0; i10 < sizeof(YFP_reporter_2_devices); i10 = i10 + 1) {} 

A1_AmtRDevice = A1_AmtR_devices[i1];
H1_HlyIIRDevice = H1_HlyIIR_devices[i2];
Q2_QacRDevice = Q2_QacR_devices[i3];
E1_BetIDevice = E1_BetI_devices[i4];
I1_IcaRADevice = I1_IcaRA_devices[i5];
S4_SrpRDevice = S4_SrpR_devices[i6];
L1_LitRDevice = L1_LitR_devices[i7];
B3_BM3R1Device = B3_BM3R1_devices[i8];
YFP_reporterDevice = YFP_reporter_devices[i9];
YFP_reporter_2Device = YFP_reporter_2_devices[i10];

Device circuit(
    A1_AmtRDevice,
    H1_HlyIIRDevice,
    Q2_QacRDevice,
    E1_BetIDevice,
    I1_IcaRADevice,
    S4_SrpRDevice,
    L1_LitRDevice,
    B3_BM3R1Device,
    YFP_reporterDevice,
    YFP_reporter_2Device,
    Loc1,
    Loc2,
    Loc3
);


result = permute(circuit);

allResults = allResults + result;

}
}
}
}
