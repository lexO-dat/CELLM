# LLM Provider Configuration
# Choose between "local" (Ollama) or "api" for each model
UCF_PROVIDER=local
VERILOG_PROVIDER=local
EMBEDDING_PROVIDER=local

# Supabase Configuration (required for vector storage)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_UCF_MODEL=phi4
LOCAL_VERILOG_MODEL=verilog-r1-32b
LOCAL_EMBEDDING_MODEL=mxbai-embed-large:latest

# OpenAI Configuration (for UCF selection when UCF_PROVIDER=api and embeddings when EMBEDDING_PROVIDER=api)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_UCF_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek Configuration (for Verilog generation when VERILOG_PROVIDER=api)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_VERILOG_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Example configurations:
# Use local models for everything:
# UCF_PROVIDER=local
# VERILOG_PROVIDER=local
# EMBEDDING_PROVIDER=local

# Use APIs for everything:
# UCF_PROVIDER=api
# VERILOG_PROVIDER=api
# EMBEDDING_PROVIDER=api

# Mixed setup (local LLMs with OpenAI embeddings):
# UCF_PROVIDER=local
# VERILOG_PROVIDER=local
# EMBEDDING_PROVIDER=api
# VERILOG_PROVIDER=api