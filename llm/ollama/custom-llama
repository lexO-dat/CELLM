  input wire L,
  input wire M,
  input wire N,
  output wire Q,
  output wire R
);
  always @(*) begin
    case({L,M,N})
      3'b000: {Q,R} = 2'b01;
      3'b001: {Q,R} = 2'b10;
      3'b010: {Q,R} = 2'b11;
      3'b011: {Q,R} = 2'b00;
      3'b100: {Q,R} = 2'b00;
      3'b101: {Q,R} = 2'b00;
      3'b110: {Q,R} = 2'b00;
      3'b111: {Q,R} = 2'b00;
