PartType spacer;
PartType scar;
PartType promoter;
PartType ribozyme;
PartType rbs;
PartType cds;
PartType terminator;
PartType cassette;

promoter pTac(.SEQUENCE("AACGATCGTTGGCTGTGTTGACAATTAATCATCGGCTCGTATAATGTGTGGAATTGTGAGCGCTCACAATT"));
promoter pTet(.SEQUENCE("TACTCCACCGTTGGCTTTTTTCCCTATCAGTGATAGAGATTGACATCCCTATCAGTGATAGAGATAATGAGCAC"));
promoter pLuxStar(.SEQUENCE("ATAGCTTCTTACCGGACCTGTAGGATCGTACAGGTTTACGCAAGAAAATGGTTTGTTACTTTCGAATAAA"));
ribozyme BydvJ(.SEQUENCE("CTGAagGGTGTCTCAAGGTGCGTACCTTGACTGATGAGTCCGAAAGGACGAAACACCcctctacaaataattttgtttaa"));
rbs A1(.SEQUENCE("AATGTTCCCTAATAATCAGCAAAGAGGTTACTAG"));
cds AmtR(.SEQUENCE(""));
terminator L3S2P55(.SEQUENCE("CTCGGTACCAAAGACGAACAATAAGACGCTGAAAAGCGTCTTTTTTCGTTTTGGTCC"));
promoter pAmtR(.SEQUENCE("CTTGTCCAACCAAATGATTCGTTACCAATTGACAGTTTCTATCGATCTATAGATAATGCTAGC"));
ribozyme RiboJ51(.SEQUENCE("CTGAAGTAGTCACCGGCTGTGCTTGCCGGTCTGATGAGCCTGTGAAGGCGAAACTACCTCTACAAATAATTTTGTTTAA"));
rbs H1(.SEQUENCE("ACCCCCGAG"));
cds HlyIIR(.SEQUENCE(""));
terminator ECK120033736(.SEQUENCE("aacgcatgagAAAGCCCCCGGAAGATCACCTTCCGGGGGCTTTtttattgcgc"));
promoter pHlyIIR(.SEQUENCE("ACCAGGAATCTGAACGATTCGTTACCAATTGACATATTTAAAATTCTTGTTTAAAatgctagc"));
ribozyme ElvJ(.SEQUENCE("CTGAagCCCCATAGGGTGGTGTGTACCACCCCTGATGAGTCCAAAAGGACGAAATGGGGcctctacaaataattttgtttaa"));
rbs I1(.SEQUENCE("ATTGCTATGGACTATGTTTCAAAGTGAGAATACTAG"));
cds IcaRA(.SEQUENCE(""));
terminator ECK120016170(.SEQUENCE("ACAATTTTCGAAAAAACCCGCTTCGGCGGGTTTTTTTATAGCTAAAA"));
promoter pIcaRA(.SEQUENCE("GTCAACTCATAAGATtctgattcgttaccaattgacaaTTCACCTACCTTTCGTTAGgTTAGGTTGT"));
ribozyme RiboJ53(.SEQUENCE("CTGAAGCGGTCAACGCATGTGCTTTGCGTTCTGATGAGACAGTGATGTCGAAACCGCCTCTACAAATAATTTTGTTTAA"));
cds PhlF(.SEQUENCE(""));
terminator ECK120033737(.SEQUENCE("GGAAACACAGAAAAAAGCCCGCACCTGACAGTGCGGGCTTTTTTTTTCGACCAAAGG"));
promoter pPhlF(.SEQUENCE("CGACGTACGGTGGAATCTGATTCGTTACCAATTGACATGATACGAAACGTACCGTATCGTTAAGGT"));
rbs P3(.SEQUENCE("CTTTACGAGGGCGATCCT"));
ribozyme RiboJ60(.SEQUENCE("CTGAAGTCGTCAAGTGCTGTGCTTGCACTTCTGATGAGGCAGTGATGCCGAAACGACCTCTACAAATAATTTTGTTTAA"));
cds QacR(.SEQUENCE(""));
terminator ECK120010818(.SEQUENCE("GTCAGTTTCACCTGTTTTACGTAAAAACCCGCTTCGGCGGGTTTTTACTTTTGG"));
promoter pQacR(.SEQUENCE("GGTATGGAAGCTATACGTTACCAATTGACAGCTAGCTCAGTCCTACTTTAGTATATAGACCGTGCGATCGGTCTATA"));
rbs Q2(.SEQUENCE("GCCATGCCATTGGCTTTTGATAGAGGACAACTACTAG"));
ribozyme RiboJ10(.SEQUENCE("CTGAAGCGCTCAACGGGTGTGCTTCCCGTTCTGATGAGTCCGTGAGGACGAAAGCGCCTCTACAAATAATTTTGTTTAA"));
cds SrpR(.SEQUENCE(""));
promoter pSrpR(.SEQUENCE("TCTATGATTGGTCCAGATTCGTTACCAATTGACAGCTAGCTCAGTCCTAGGTATATACATACATGCTTGTTTGTTTGTAAAC"));
terminator ECK120029600(.SEQUENCE("TTCAGCCAAAAAACTTAAGACCGCCGGTCTTGTCCACTACCTTGCAGTAATGCGGTGGACAGGATCGGCGGTTTTCTTTTCTCTTCTCAA"));
rbs S4(.SEQUENCE("CTATGGACTATGTTTTCACACAGGAAATACCAGG"));
scar F_scar(.SEQUENCE("CGCT"));
scar E_scar(.SEQUENCE("GCTT"));
scar D_scar(.SEQUENCE("AGGT"));
scar C_scar(.SEQUENCE("AATG"));
scar B_scar(.SEQUENCE("TACG"));
scar A_scar(.SEQUENCE("GGAG"));
scar Y_scar(.SEQUENCE("ATTG"));
scar X_scar(.SEQUENCE("TGTC"));
scar V_scar(.SEQUENCE("TCTG"));
scar U_scar(.SEQUENCE("GGGC"));
scar R_scar(.SEQUENCE("GTAA"));
scar Q_scar(.SEQUENCE("GAGT"));
scar P_scar(.SEQUENCE("CCTA"));
scar O_scar(.SEQUENCE("ATGC"));
scar G_scar(.SEQUENCE("ATAG"));
cassette YFP_cassette(.SEQUENCE(""));

PartType fencepost;
fencepost Loc1();
fencepost Loc2();
fencepost Loc3();

cassette Q2_QacR_cassette();
Device Q2_QacR(
    pTet,
    Q2_QacR_cassette
);

cassette A1_AmtR_cassette();
Device A1_AmtR(
    pTac,
    A1_AmtR_cassette
);

cassette S4_SrpR_cassette();
Device S4_SrpR(
    pLuxStar,
    S4_SrpR_cassette
);

cassette I1_IcaRA_cassette();
Device I1_IcaRA(
    pQacR,
    pAmtR,
    I1_IcaRA_cassette
);

cassette H1_HlyIIR_cassette();
Device H1_HlyIIR(
    pIcaRA,
    H1_HlyIIR_cassette
);

cassette P3_PhlF_cassette();
Device P3_PhlF(
    pSrpR,
    pHlyIIR,
    P3_PhlF_cassette
);

Device YFP_reporter(
    pPhlF,
    YFP_cassette
);


Rule Q2_QacRRule0( ON Q2_QacR:
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule A1_AmtRRule0( ON A1_AmtR:
    STARTSWITH pTac AND
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule S4_SrpRRule0( ON S4_SrpR:
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule I1_IcaRARule0( ON I1_IcaRA:
    ALL_FORWARD AND
    ALL_FORWARD AND
    STARTSWITH pQacR AND
    pQacR BEFORE pAmtR
);

Rule H1_HlyIIRRule0( ON H1_HlyIIR:
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule P3_PhlFRule0( ON P3_PhlF:
    ALL_FORWARD AND
    ALL_FORWARD AND
    STARTSWITH pSrpR AND
    pSrpR BEFORE pHlyIIR
);

Rule YFP_reporterRule0( ON YFP_reporter:
    ALL_FORWARD AND
    ALL_FORWARD AND
    STARTSWITH pPhlF
);


Q2_QacR_devices = product(Q2_QacR);
A1_AmtR_devices = product(A1_AmtR);
S4_SrpR_devices = product(S4_SrpR);
I1_IcaRA_devices = product(I1_IcaRA);
H1_HlyIIR_devices = product(H1_HlyIIR);
P3_PhlF_devices = product(P3_PhlF);
YFP_reporter_devices = product(YFP_reporter);

Device Q2_QacRDevice();
Device A1_AmtRDevice();
Device S4_SrpRDevice();
Device I1_IcaRADevice();
Device H1_HlyIIRDevice();
Device P3_PhlFDevice();
Device YFP_reporterDevice();

Device circuit();

Rule CircuitRule0( ON circuit:
    CONTAINS Q2_QacR AND
    CONTAINS A1_AmtR AND
    CONTAINS S4_SrpR AND
    CONTAINS I1_IcaRA AND
    CONTAINS H1_HlyIIR AND
    CONTAINS P3_PhlF AND
    CONTAINS YFP_reporter AND
    YFP_reporter NEXTTO Loc3 AND
    YFP_reporter AFTER Loc3 AND
    STARTSWITH Loc1 AND
    Loc2 NEXTTO Loc1 AND
    P3_PhlF BEFORE S4_SrpR AND
    P3_PhlF BEFORE I1_IcaRA AND
    P3_PhlF BEFORE Q2_QacR AND
    P3_PhlF BEFORE H1_HlyIIR AND
    P3_PhlF BEFORE A1_AmtR AND
    S4_SrpR BEFORE I1_IcaRA AND
    S4_SrpR BEFORE Q2_QacR AND
    S4_SrpR BEFORE H1_HlyIIR AND
    S4_SrpR BEFORE A1_AmtR AND
    I1_IcaRA BEFORE Q2_QacR AND
    I1_IcaRA BEFORE H1_HlyIIR AND
    I1_IcaRA BEFORE A1_AmtR AND
    Q2_QacR BEFORE H1_HlyIIR AND
    Q2_QacR BEFORE A1_AmtR AND
    H1_HlyIIR BEFORE A1_AmtR AND
    P3_PhlF AFTER Loc2 AND
    S4_SrpR AFTER Loc2 AND
    I1_IcaRA AFTER Loc2 AND
    Q2_QacR AFTER Loc2 AND
    H1_HlyIIR AFTER Loc2 AND
    A1_AmtR AFTER Loc2 AND
    P3_PhlF BEFORE Loc3 AND
    S4_SrpR BEFORE Loc3 AND
    I1_IcaRA BEFORE Loc3 AND
    Q2_QacR BEFORE Loc3 AND
    H1_HlyIIR BEFORE Loc3 AND
    A1_AmtR BEFORE Loc3 AND
    ALL_FORWARD AND
    CONTAINS Q2_QacR AND
    CONTAINS A1_AmtR AND
    CONTAINS S4_SrpR AND
    CONTAINS I1_IcaRA AND
    CONTAINS H1_HlyIIR AND
    CONTAINS P3_PhlF AND
    CONTAINS YFP_reporter
);
Array allResults;

for(num i1 = 0; i1 < sizeof(Q2_QacR_devices); i1 = i1 + 1) {} 
for(num i2 = 0; i2 < sizeof(A1_AmtR_devices); i2 = i2 + 1) {} 
for(num i3 = 0; i3 < sizeof(S4_SrpR_devices); i3 = i3 + 1) {} 
for(num i4 = 0; i4 < sizeof(I1_IcaRA_devices); i4 = i4 + 1) {} 
for(num i5 = 0; i5 < sizeof(H1_HlyIIR_devices); i5 = i5 + 1) {} 
for(num i6 = 0; i6 < sizeof(P3_PhlF_devices); i6 = i6 + 1) {} 
for(num i7 = 0; i7 < sizeof(YFP_reporter_devices); i7 = i7 + 1) {} 

Q2_QacRDevice = Q2_QacR_devices[i1];
A1_AmtRDevice = A1_AmtR_devices[i2];
S4_SrpRDevice = S4_SrpR_devices[i3];
I1_IcaRADevice = I1_IcaRA_devices[i4];
H1_HlyIIRDevice = H1_HlyIIR_devices[i5];
P3_PhlFDevice = P3_PhlF_devices[i6];
YFP_reporterDevice = YFP_reporter_devices[i7];

Device circuit(
    Q2_QacRDevice,
    A1_AmtRDevice,
    S4_SrpRDevice,
    I1_IcaRADevice,
    H1_HlyIIRDevice,
    P3_PhlFDevice,
    YFP_reporterDevice,
    Loc1,
    Loc2,
    Loc3
);


result = permute(circuit);

allResults = allResults + result;

}
}
}
}
}
